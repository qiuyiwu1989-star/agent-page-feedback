# 复制为 .env 并修改（不要提交 .env）
FB_TEAM_CODE=换成团队口令
FB_ADMIN_CODE=换成管理员口令
FB_DB=/opt/agent-page-feedback/data/fb.db
FB_PORT=18810
FB_PREFIX=/api/fb/
FB_SITE=https://example.com/
# 验收流程：默认开。agent 改完要管理员口令点「通过」才算完成；设为 0 则任何人都可以直接标「已改好」
FB_ACCEPTANCE=1
# 选填：新批注 / 回复 / 状态变化时通知（飞书群机器人地址）
FB_NOTIFY_URL=
FB_NOTIFY_KIND=feishu
