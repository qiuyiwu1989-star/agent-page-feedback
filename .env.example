# 复制为 .env 并修改（不要提交 .env）
FB_TEAM_CODE=换成团队口令
FB_ADMIN_CODE=换成管理员口令
# 选填：agent 专用口令（定时任务用：能发布、回滚、发汇总，不能拍板）
FB_AGENT_CODE=
FB_DB=/opt/agent-page-feedback/data/fb.db
FB_PORT=18810
FB_PREFIX=/api/fb/
FB_SITE=https://example.com/
# 选填：新批注 / 回复 / 状态变化时通知（飞书群机器人地址）
FB_NOTIFY_URL=
FB_NOTIFY_KIND=feishu
# 选填：发布脚本（固定路径），样例见 deploy/deploy.sh.example；服务器和对象存储的密钥只放在服务器上
FB_DEPLOY_CMD=
FB_DEPLOY_TIMEOUT=900
